Initial python script generated: 
def get_pipelines(start_month: int = 202503, end_month: int = 202602):
    pipelines = f"""
        [
        {{
            "collection": "billing_usage_monthly",
            "pipeline": [
            {{
                "$match": {{
                "callType": "IDD",
                "monthCode": {{
                    "$gte": {start_month},
                    "$lte": {end_month}
                }}
                }}
            }},
            {{
                "$group": {{
                "_id": "$monthCode",
                "totalCost": {{
                    "$sum": {{
                    "$ifNull": [
                        "$billedValue",
                        0
                    ]
                    }}
                }}
                }}
            }},
            {{
                "$sort": {{
                "_id": 1
                }}
            }},
            {{
                "$project": {{
                "_id": 0,
                "month": {{
                    "$concat": [
                    {{
                        "$substrBytes": [
                        {{
                            "$toString": "$_id"
                        }},
                        0,
                        4
                        ]
                    }},
                    "-",
                    {{
                        "$substrBytes": [
                        {{
                            "$toString": "$_id"
                        }},
                        4,
                        2
                        ]
                    }}
                    ]
                }},
                "totalCost": 1
                }}
            }}
            ]
        }}
        ]
        """
    return pipelines
